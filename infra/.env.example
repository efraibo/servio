# 🟢 Copie para infra/.env (ignorado pelo git). Valores fictícios, só para desenvolvimento local.
POSTGRES_PASSWORD=ficticia-super
SERVIO_OWNER_PASSWORD=ficticia-owner
SERVIO_APP_PASSWORD=ficticia-app
# Para rodar o backend no host, exporte as variáveis: set -a; . infra/.env; set +a
# Com outra porta, exporte também SERVIO_DB_URL=jdbc:postgresql://localhost:<porta>/servio
# Opcional: porta no host (padrão 5432).
# POSTGRES_PORT=5432
